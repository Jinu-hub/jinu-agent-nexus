{
  "name": "jinu-agent-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Agents boilerplate — Think-based chat agent with memory, skills, workspace files, RAG, browser, schedules, extensions, and MCP client. Built for the Nomad Coders Cloudflare Agents course.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "setup": "node scripts/setup.mjs",
    "setup:r2": "wrangler r2 bucket create boilerplate-bucket",
    "setup:vectorize": "wrangler vectorize create boilerplate-vectorstore --dimensions=768 --metric=cosine",
    "seed:skills:local": "wrangler r2 object put boilerplate-bucket/skills/example-skill.md --file ./skills/example-skill.md --local",
    "seed:skills:remote": "wrangler r2 object put boilerplate-bucket/skills/example-skill.md --file ./skills/example-skill.md --remote"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/react": "^3.0.178",
    "@cloudflare/ai-chat": "0.6.2",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/shell": "^0.4.3",
    "@cloudflare/think": "0.5.3",
    "agents": "0.12.3",
    "ai": "6.0.176",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "wrangler": "^4.93.0"
  },
  "overrides": {
    "ai": "6.0.176",
    "@ai-sdk/react": "3.0.178"
  }
}
