# ─────────────────────────────────────────────────────────────────────────
# Local development secrets — copy this file to `.dev.vars` and fill in.
#
# `.dev.vars` is git-ignored. Wrangler reads it automatically when you
# run `npm run dev`. For production, push each secret with:
#   npx wrangler secret put API_TOKEN
# ─────────────────────────────────────────────────────────────────────────

# Cloudflare API token.
#
# REQUIRED for:
#   * The Live Browser panel (Browser Rendering Live View URL signing).
#
# OPTIONAL until you switch CHAT_MODEL or EMBEDDING_MODEL to a non-
# Workers-AI model in wrangler.jsonc — then it becomes REQUIRED for:
#   * AI Gateway auth (the `Authorization: Bearer` header).
#   * AI Gateway Unified Billing (the gateway charges this account's
#     Cloudflare credits for the model usage; no upstream OpenAI /
#     Anthropic key required).
#
# Create the token at:
#   https://dash.cloudflare.com/profile/api-tokens
#
# Required permissions on the token:
#   * Account → Browser Rendering → Edit
#   * Account → AI Gateway → Run         (only if using AI Gateway)
#
# Use a custom token, NOT the legacy global API key.
API_TOKEN=

# Room token for the Live Market Room (/live).
#
# Visitors must pass it as `?token=<value>`; connections without it are
# closed in onConnect. OPTIONAL — when unset, the room accepts the
# built-in dev token `market-pulse` (see worker/live-market-room.ts).
LIVE_ROOM_TOKEN=

# Supabase — Market Memory (shared market data) + Phase 2 Auth.
# Never put the service role key in the browser; Worker-only via
# createSupabaseClient() in worker/supabase.ts. The anon key is also
# exposed to the browser via GET /api/auth/config (public-by-design).
#
# Find these in: Supabase Dashboard → Project Settings → API
#   SUPABASE_URL              → Project URL
#   SUPABASE_ANON_KEY         → anon / public (RLS-aware + Auth)
#   SUPABASE_SERVICE_ROLE_KEY → service_role (bypasses RLS; server only)
#
# Auth setup (same project as Market Memory):
#   1. Authentication → Providers → Email (magic link) on
#   2. (Optional) Google provider
#   3. Authentication → URL Configuration → Redirect URLs — ADD (Site URL은
#      Market Memory 대시보드여도 됨; 매직 링크는 여기 없으면 Site URL로 떨어짐):
#        http://localhost:5173
#        http://localhost:5173/**
#        https://<your-worker>.workers.dev
#        https://<your-worker>.workers.dev/**
#
# Do NOT wrap values in quotes in `.dev.vars` — paste the raw URL/JWT.
#
# Production:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_ANON_KEY
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 — Admin allowlist (optional). Comma-separated.
# Admins keep their personal userId DO; this does NOT switch to "default".
# Match by Supabase auth.users.id and/or email (case-insensitive).
#   ADMIN_USER_IDS=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
#   ADMIN_EMAILS=you@example.com,other@example.com
# Production:
#   npx wrangler secret put ADMIN_USER_IDS
#   npx wrangler secret put ADMIN_EMAILS
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Optional. Direct OpenAI TTS for Voice generation (Phase 4).
# If unset, the Worker calls AI Gateway with API_TOKEN instead
# (Unified Billing or a stored OpenAI key on the gateway).
#   npx wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=
